{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": ".",
      "framework": "fastapi"
    },
    "web": {
      "root": "web",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    {
      "source": "/health",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/predict",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/predict/:path*",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/simulate/:path*",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/docs",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/openapi.json",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
